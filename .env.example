# Copy this file to .env and set your own password. .env is gitignored.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safepaws
DB_USER=safepaws
DB_PASSWORD=change-me
FRONTEND_URL=http://localhost:4200
# Frontend addresses allowed to call the API; add the laptop's IP to open the app from a phone
CORS_ALLOWED_ORIGINS=http://localhost:4200
JWT_SECRET=change-me-to-a-random-256-bit-secret-at-least-32-chars
